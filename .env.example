# LLM Configuration
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_PROVIDER=openai

# Consensus Settings
CONSENSUS_THRESHOLD=0.85
CONSENSUS_MAX_ITERATIONS=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Docker
DOCKER_IMAGE=maven:3.9-eclipse-temurin-17
DOCKER_TIMEOUT=300
